# Copy to .env and configure for your environment.
# Note: On physical Android devices, 'localhost' points to the device itself.
# Use your computer's LAN IP for physical device testing, or HTTPS for production.

# --- LOCAL PHYSICAL DEVICE / LAN DEVELOPMENT ---
# Find your PC's IP via `ipconfig` (Windows) or `ifconfig` (Mac/Linux)
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3001

# --- ANDROID EMULATOR LOCAL DEVELOPMENT ---
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3001

# --- PRODUCTION ANDROID / EAS RELEASE BUILDS (Required HTTPS) ---
EXPO_PUBLIC_API_URL=https://api.yetrixtechnologies.com

# Customer mobile Maps keys are public client keys, but they must still be
# restricted in Google Cloud Console before any release build:
# - Android key: restrict to package com.goocart.customer + release SHA-1
# - iOS key: restrict to bundle id com.goocart.customer
# Enable only the Maps SDK/API surfaces the app actually uses.
# GOOCART_ANDROID_GOOGLE_MAPS_API_KEY=REPLACE_WITH_RESTRICTED_ANDROID_MAPS_KEY
# GOOCART_IOS_GOOGLE_MAPS_API_KEY=REPLACE_WITH_RESTRICTED_IOS_MAPS_KEY

